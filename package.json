{
  "name": "mayajaal",
  "displayName": "Mayajaal — Web of Magic",
  "description": "A themed VS Code experience for a Spider-Man fan and a Potterhead: a dark 'web-and-wand' colour theme, a calligraphy banner inserter, and a magical animated welcome panel.",
  "version": "1.1.0",
  "publisher": "KANAKPRABHAKAR",
  "author": {
    "name": "Kanak Prabhakar"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "dark",
    "spiderman",
    "harry potter",
    "calligraphy"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Mayajaal (Web & Wand)",
        "uiTheme": "vs-dark",
        "path": "./themes/mayajaal-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "mayajaal.welcome",
        "title": "Mayajaal: Open Magical Welcome"
      },
      {
        "command": "mayajaal.spell",
        "title": "Mayajaal: Cast a Spell (motivation)"
      },
      {
        "command": "mayajaal.banner",
        "title": "Mayajaal: Insert Calligraphy Banner"
      },
      {
        "command": "mayajaal.jaaduToggle",
        "title": "Mayajaal: जादू चालू/बंद करो",
        "category": "Mayajaal"
      }
    ],
    "configuration": {
      "title": "Mayajaal",
      "properties": {
        "mayajaal.jaadu.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Typing effects. Turn this off and Mayajaal is just the colour theme."
        },
        "mayajaal.jaadu.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the streak counter in the status bar."
        },
        "mayajaal.jaadu.cursorMarks": {
          "type": "boolean",
          "default": true,
          "description": "Show a small mark beside the cursor as you type."
        },
        "mayajaal.jaadu.milestones": {
          "type": "boolean",
          "default": true,
          "description": "Announce milestones — 25, 50, 100, 200, 300, 500 characters in one streak."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kanak234/mayajaal.git"
  },
  "bugs": {
    "url": "https://github.com/Kanak234/mayajaal/issues"
  },
  "homepage": "https://github.com/Kanak234/mayajaal#readme",
  "icon": "icon.png",
  "scripts": {
    "test": "node test/jaadu.test.js"
  }
}
